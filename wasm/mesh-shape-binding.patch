+	// createHull below), b3CreateMeshShape does NOT clone the b3MeshData it's
+	// given -- box3d.h: "The shape definition is fully cloned but the mesh is
+	// not." So a body that creates a mesh shape via createMesh() owns that
+	// heap allocation for as long as the shape lives, and must free it here.
+	b3MeshData* ownedMesh = nullptr;
+
 	bool isValid() const
 	{
 		return b3Body_IsValid( id );
@@ -786,6 +793,11 @@ struct Body
 	{
 		b3DestroyBody( id );
 		id = b3_nullBodyId;
