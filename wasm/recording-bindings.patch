+// Owns a b3Recording buffer. This build has FILESYSTEM=0 (no libc file I/O in
+// the wasm sandbox), so b3SaveRecordingToFile/b3LoadRecordingFromFile/
+// b3ValidateReplay/b3RecPlayer* are deliberately not bound here -- those all
+// assume a real filesystem underneath. getData() instead hands back a raw
+// view over the wasm heap so JS can copy the bytes into a Blob itself.
+struct Recording
+{
+	b3Recording* ptr;
+
+	explicit Recording( int byteCapacity )
+	{
+		ptr = b3CreateRecording( byteCapacity );
+	}
+
+	void destroy()
+	{
+		b3DestroyRecording( ptr );
+		ptr = nullptr;
+	}
+
+	int getSize() const
+	{
+		return b3Recording_GetSize( ptr );
+	}
+
+	// Zero-copy view over the recording's current bytes. Only valid until the
+	// next call that mutates or destroys this recording (a subsequent
+	// StartRecording reset, or destroy()) -- copy out of it (e.g. `new
+	// Uint8Array(view)`) before doing anything else with the recording.
+	val getData() const
+	{
+		int size = b3Recording_GetSize( ptr );
+		const uint8_t* data = b3Recording_GetData( ptr );
+		if ( size <= 0 || data == nullptr )
+		{
+			return val( emscripten::typed_memory_view( 0, (const uint8_t*)nullptr ) );
+		}
+		return val( emscripten::typed_memory_view( size, data ) );
+	}
+};
+
